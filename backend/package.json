{
    "name": "task-manager-api",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "description": "REST API for the multi-container Task Manager application",
    "main": "src/server.js",
    "scripts": {
        "start": "node src/server.js",
        "dev": "node --watch src/server.js",
        "db:migrate": "node src/db/migrate.js",
        "test": "node --test",
        "test:api": "node --test tests/integration/api.test.js",
        "test:db": "node --test tests/integration/database.integration.js",
        "lint": "eslint ."
    },
    "engines": {
        "node": ">=22"
    },
    "dependencies": {
        "express": "^5.1.0",
        "node-pg-migrate": "^9.0.0",
        "pg": "^8.13.1",
        "redis": "^6.3.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "eslint": "^10.13.0",
        "globals": "^17.13.0",
        "supertest": "^7.3.1"
    }
}
